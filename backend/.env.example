# Copy to .env and adjust. Never commit .env.
# Settings validate these at startup and fail fast with a clear message.

# --- Django ---
# Required. Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=dev-insecure-key-replace-in-production
DJANGO_DEBUG=true
# Comma-separated. Add the Fly.io hostname in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (ADR-0004: SQLite) ---
# Local: relative path. Fly.io: /data/db.sqlite3 (mounted persistent volume).
DATABASE_PATH=db.sqlite3

# --- CORS (ADR-0005: SPA is cross-origin) ---
# Comma-separated. Add the deployed Vercel origin in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- DataSF Socrata API (ADR-0003: batch ingestion) ---
SOCRATA_BASE_URL=https://data.sfgov.org
SOCRATA_DATASET_ID=yitu-d5am
# Optional. Unauthenticated requests are throttled harder but work fine at this volume.
# Register at https://evergreen.data.socrata.com/profile/app_tokens
SOCRATA_APP_TOKEN=
SOCRATA_TIMEOUT_SECONDS=15
SOCRATA_MAX_RETRIES=3
SOCRATA_PAGE_SIZE=1000

# --- Logging ---
LOG_LEVEL=INFO
